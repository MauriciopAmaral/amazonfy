# Amazunfy — configuração para a Hostinger (Apache/LiteSpeed)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS: ative em hPanel → Segurança → SSL → "Forçar HTTPS".

  # A API e os uploads seguem para seus próprios arquivos
  RewriteRule ^(api|uploads)(/|$) - [L]

  # Arquivos e pastas que existem são servidos normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto é rota do React (ex.: /artist/3) → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Cache longo para os arquivos com hash gerados pelo build
<IfModule mod_headers.c>
  <FilesMatch "^assets/.*\.(js|css|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
